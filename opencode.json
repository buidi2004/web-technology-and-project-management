{
  "$schema": "https://opencode.ai/config.json",
  "skills": { "paths": [".aidlc/skills"] },
  "instructions": [".aidlc/onboarding.md", "aidlc/active-memory/**/*.md"],
  "mcp": {
    "servers": {
      "dthu-ui": {
        "type": "remote",
        "url": "https://dthu-kit.anhdev99.com/mcp"
      }
    }
  },
  "permission": {
    "edit": {
      ".aidlc/tools/**": "ask",
      ".aidlc/hooks/**": "ask"
    },
    "bash": {
      "rm -r*": "ask",
      "git push *": "ask",
      "aidlc engine *": "allow"
    }
  }
}
